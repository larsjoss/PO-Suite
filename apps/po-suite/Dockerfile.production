# Stage 1: Build
FROM node:20-alpine AS builder
WORKDIR /app

ARG VITE_TARGET=enterprise
ARG VITE_API_URL=http://localhost:3000

COPY package*.json ./
RUN npm ci

COPY index.html tsconfig*.json vite.config.ts postcss.config.cjs tailwind.config.ts ./
COPY src ./src
COPY public ./public

ENV VITE_TARGET=${VITE_TARGET}
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build

# Stage 2: Runtime
FROM nginx:1.27-alpine AS runtime

# nginx writes temp files to /tmp (required for OpenShift restricted-v2 SCC)
RUN mkdir -p /tmp/nginx /var/cache/nginx/client_temp \
    && chown -R nginx:nginx /tmp/nginx \
    && chmod -R 755 /tmp/nginx

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

# Non-root: nginx:nginx (uid=101 on alpine) — compatible with OpenShift
USER nginx

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
  CMD wget -qO- http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
