{
  "name": "po-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.3"
  },
  "scripts": {
    "dev":      "npm run dev      -w apps/po-suite",
    "build":    "npm run build    -w apps/po-suite",
    "test":     "npm run test:run -w apps/po-suite",
    "lint":     "npm run lint --if-present -w apps/po-suite && npm run lint --if-present -w apps/backend",
    "lint:fix": "npm run lint:fix -w apps/po-suite"
  }
}
